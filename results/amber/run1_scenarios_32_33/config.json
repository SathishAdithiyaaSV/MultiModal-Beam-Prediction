{
  "model": {
    "n_beams": 64,
    "window": 5,
    "embed_dim": 256,
    "n_heads": 8,
    "dropout": 0.1,
    "pool_hw": [
      4,
      4
    ],
    "n_layers_specific": 2,
    "n_layers_fusion": 2,
    "ffn_ratio": 4,
    "image_backbone": "resnet34",
    "lidar_backbone": "resnet18",
    "radar_backbone": "resnet18",
    "pretrained": true,
    "image_channels": 3,
    "lidar_channels": 1,
    "radar_channels": 2,
    "temporal_pool": "concat",
    "modality_temperature": 1.0,
    "contrastive_temperature": 0.07
  },
  "train": {
    "batch_size": 16,
    "lr": 0.0001,
    "epochs": 20,
    "optimizer": "adamw",
    "weight_decay": 0.05,
    "warmup_steps": 5,
    "grad_clip": 1.0,
    "lambda_focal": 10.0,
    "lambda_contrastive": 0.2,
    "lambda_reg": 0.2,
    "focal_balance": 0.25,
    "focal_scaling": 2.0,
    "soft_label_sigma": 1.0,
    "modality_dropout": 0.15,
    "topk": [
      1,
      3,
      5
    ],
    "dba_delta": 5.0,
    "seed": 2022,
    "num_workers": 2,
    "device": "cuda"
  },
  "modalities": [
    "image",
    "lidar",
    "radar",
    "beam",
    "gps"
  ]
}