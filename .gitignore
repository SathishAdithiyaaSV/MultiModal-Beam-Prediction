# Dataset: ~35 GB raw + ~11 GB derived. Fetch raw releases from DeepSense6G,
# regenerate derived with preprocessing_amber/run_preprocessing.sh
data/

# Run artifacts. Checkpoints are far over GitHub's 100 MB per-file limit
# (best.pt ~190 MB, last.pt ~570 MB), so only the small text outputs are
# tracked -- metrics, history and figures are what a reader actually needs.
runs/
results/**/*.pt
results/**/*.pth
results/**/*.ckpt

# Reference papers are kept locally but not redistributed (see references/README.md)
references/*.pdf

# Python
__pycache__/
*.py[cod]
.venv/

# macOS
.DS_Store
